{
  "name": "thinkxx",
  "private": true,
  "version": "0.1.0",
  "description": "Non-custodial Solana Mobile dApp for emergency access and inheritance planning",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapirl7/thinkxx.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:anchor": "anchor build && pnpm exec ts-mocha -p ./tsconfig.json -t 60000 'tests/**/*.ts'",
    "test:sdk": "turbo run test --filter=@thinkxx/sdk",
    "test:mobile": "turbo run test --filter=@thinkxx/mobile",
    "test:all:local": "pnpm run test:sdk && pnpm run test:mobile",
    "test:full:local": "pnpm run test:sdk && pnpm run test:mobile && pnpm run test:anchor",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@solana/web3.js": "^1.95.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "anchor-bankrun": "^0.5.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "prettier": "^3.2.0",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^11.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
