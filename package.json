{
  "name": "thinkxx",
  "private": true,
  "version": "0.1.0",
  "description": "Non-custodial Solana Mobile dApp for emergency access and inheritance planning",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapirl7/thinkxx.git"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:anchor": "anchor build && pnpm exec ts-mocha -p ./tsconfig.json -t 60000 'tests/**/*.ts'",
    "test:sdk": "turbo run test --filter=@thinkxx/sdk",
    "test:mobile": "turbo run test --filter=@thinkxx/mobile",
    "test:all:local": "pnpm run test:sdk && pnpm run test:mobile",
    "test:full:local": "pnpm run test:sdk && pnpm run test:mobile && pnpm run test:anchor",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "0.30.1",
    "@eslint/js": "^9.15.0",
    "@solana/web3.js": "^1.95.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "anchor-bankrun": "^0.5.0",
    "chai": "^6.2.2",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "mocha": "^11.7.5",
    "prettier": "^3.2.0",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^11.1.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "diff@>=6.0.0 <8.0.3": ">=8.0.3",
      "flatted@<3.4.0": ">=3.4.0",
      "flatted@<=3.4.1": ">=3.4.2",
      "handlebars@>=4.0.0 <=4.7.8": ">=4.7.9",
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "handlebars@>=4.6.0 <=4.7.8": ">=4.7.9",
      "node-forge@<=1.3.3": ">=1.4.0",
      "node-forge@<1.4.0": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@<=6.4.2": ">=6.4.3",
      "postcss@<8.5.10": ">=8.5.10",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "turbo@>=1.1.0 <2.9.14": ">=2.9.14",
      "turbo@<=2.9.13": ">=2.9.14",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "serialize-javascript@>=5.0.0 <7.0.5": ">=7.0.5",
      "vitest@<3.2.6": ">=3.2.6",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4 <8",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0 <5"
    }
  }
}
